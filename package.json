{
  "name": "ithaca-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.mjs",
    "test:e2e": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5434/ithaca_test} playwright test",
    "test:e2e:seed": "node scripts/e2e/seed-pilot.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run prisma:validate",
    "eval:ai": "vitest run --config vitest.eval-live.config.ts eval/classifier-baseline.test.ts",
    "eval:ai:live": "vitest run --config vitest.eval-live.config.ts",
    "eval:ai:dataset": "node scripts/eval/generate-live-dataset.mjs",
    "eval:transformer": "vitest run --config vitest.eval-live.config.ts eval/transformer-corpus.test.ts --reporter=verbose",
    "eval:transformer:live": "vitest run --config vitest.eval-live.config.ts eval/transformer-corpus-live.test.ts --reporter=verbose",
    "test:load:budgets": "vitest run src/lib/platform/load-budgets.test.ts",
    "test:load": "node scripts/scale/run-load-tests.mjs",
    "test:load:session": "node scripts/e2e/export-session-cookie.mjs",
    "seed:disciplines": "node scripts/seed-discipline-cache.mjs",
    "seed:demo": "node scripts/seed-demo-show.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "build:extension:dev": "node scripts/build-extension.mjs --mode=dev",
    "build:extension:prod": "node scripts/build-extension.mjs --mode=prod",
    "launch:check": "node scripts/launch/readiness-check.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^6.2.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.17",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-sigma/core": "^4.0.2",
    "@react-sigma/layout-forceatlas2": "^4.0.0",
    "@upstash/qstash": "^2.11.3",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.6.1",
    "@vercel/otel": "^2.1.3",
    "better-auth": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "graphology": "^0.25.4",
    "graphology-layout-forceatlas2": "^0.10.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.1.0",
    "lucide-react": "^0.562.0",
    "motion": "^12.27.1",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.3",
    "postcss": "^8.5.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.2",
    "resend": "^6.9.2",
    "sharp": "^0.35.3",
    "sigma": "^3.0.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "postcss": "$postcss",
    "react": "$react",
    "react-dom": "$react-dom",
    "sharp": "$sharp"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "graphology-types": "^0.24.8",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7",
    "vitest": "^5.1.0"
  }
}
